GEMINI_API_KEY=your_gemini_api_key_here
INTERNAL_API_KEY=your_internal_api_key_here

# Redis (Cloud Memorystore)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Gemini model names — verify before demo day
PIPELINE_MODEL=gemini-3.1-flash-preview
DIRECTOR_MODEL=gemini-3.1-flash-preview
DIRECTOR_MODE=interleaved

# Google Cloud
GOOGLE_CLOUD_PROJECT=your_project_id
GCS_BUCKET=lotus-studio-media

# Firestore
FIRESTORE_DEMO_USER_ID=demo_user
